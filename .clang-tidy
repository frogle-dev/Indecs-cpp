Checks: 'bugprone-*,modernize-*,readability-*,-mcs*,misc-const-correctness,performance-*,clang-analyzer-*,cppcoreguidelines-pro-type-member-init,cppcoreguidelines-owning-memory'
WarningsAsErrors: 'bugprone-*,clang-analyzer-*'

CheckOptions:
  misc-const-correctness.AnalyzePointers: true
  misc-const-correctness.AnalyzeReferences: true
  misc-const-correctness.TransformValues: true
